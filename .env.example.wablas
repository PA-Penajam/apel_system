
# ===========================================
# WABLAS WHATSAPP CONFIGURATION
# ===========================================
# Get these from: https://panel.wablas.com/
# Login → Settings → API

# API Token dari dashboard Wablas (WAJIB)
WA_GATEWAY_TOKEN=your_api_token_here

# Device Token dari dashboard Wablas (WAJIB)
WA_GATEWAY_DEVICE_TOKEN=your_device_token_here

# ===========================================
# ALTERNATIVE: FONNTE CONFIGURATION
# ===========================================
# Jika menggunakan Fonnte sebagai alternatif:
# FONNTE_TOKEN=your_fonnte_token_here
# FONNTE_TARGET_GROUP=your_group_id_here

# ===========================================
# APPLICATION SETTINGS
# ===========================================

APP_NAME="APEL System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Sesuaikan dengan database Anda

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apel_db
DB_USERNAME=root
DB_PASSWORD=

# ===========================================
# EMAIL CONFIGURATION (Untuk backup notifikasi)
# ===========================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.pa-penajam.go.id
MAIL_PORT=587
MAIL_USERNAME=admin@pa-penajam.go.id
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@pa-penajam.go.id"
MAIL_FROM_NAME="APEL System"

# ===========================================
# CACHE & SESSION
# ===========================================

CACHE_DRIVER=file
SESSION_DRIVER=file

# ===========================================
# LOGGING
# ===========================================

LOG_CHANNEL=stack

# ===========================================
# WHATSAPP MESSAGE SETTINGS
# ===========================================

# Jam pelaksanaan apel
APEL_SENIN_TIME="07:30:00"
APEL_JUMAT_TIME="16:00:00"

# Pesan reminder (opsional - untuk reminder 1 hari sebelum)
ENABLE_REMINDER=false

# ===========================================
# CARA MENDAPATKAN TOKEN WABLAS
# ===========================================
#
# 1. Daftar di https://wablas.com/
# 2. Login di https://panel.wablas.com/
# 3. Hubungkan WhatsApp (scan QR Code di menu Device)
# 4. Ke Settings → API
# 5. Copy API Token dan Device Token
# 6. Paste ke WA_GATEWAY_TOKEN dan WA_GATEWAY_DEVICE_TOKEN di atas
#
# ===========================================
# TEST KONEKSI
# ===========================================
#
# Setelah mengisi token, akses URL berikut untuk test:
# - Test koneksi: https://app.test/wablas/test
# - Cek kuota: https://app.test/wablas/quota
#
# ===========================================
